                      (  turbo9_boot.asm):00051         ; //////////// Memory Map
                      (  turbo9_boot.asm):00052         ;
                      (  turbo9_boot.asm):00053         ; Initialized RAM (Vector Table): FFFF - FFF0
                      (  turbo9_boot.asm):00054         ;
                      (  turbo9_boot.asm):00055         ; FFFE : FFFF   RESET_VECTOR
                      (  turbo9_boot.asm):00056         ; FFFC : FFFD   NMI_VECTOR
                      (  turbo9_boot.asm):00057         ; FFFA : FFFB   SWI_VECTOR
                      (  turbo9_boot.asm):00058         ; FFF8 : FFF9   IRQ_VECTOR
                      (  turbo9_boot.asm):00059         ; FFF6 : FFF7   FIRQ_VECTOR
                      (  turbo9_boot.asm):00060         ; FFF4 : FFF5   SWI2_VECTOR
                      (  turbo9_boot.asm):00061         ; FFF2 : FFF3   SWI3_VECTOR
                      (  turbo9_boot.asm):00062         ; FFF0 : FFF1   RESERVED_VECTOR
                      (  turbo9_boot.asm):00063         ;
                      (  turbo9_boot.asm):00064         ;
                      (  turbo9_boot.asm):00065         ; I/O Space: FFEF - FF00
                      (  turbo9_boot.asm):00066         ;
                      (  turbo9_boot.asm):00067         ; FF08          CLK_CNT_CTRL[1:0] (read)  /  CLK_CNT_CTRL (write)
                      (  turbo9_boot.asm):00068         ; FF04 : FF07   CLK_CNT[31:0]     (read)
                      (  turbo9_boot.asm):00069         ; FF03          ACIA_STATUS       (read)
                      (  turbo9_boot.asm):00070         ; FF02          ACIA_RX_DATA      (read)  /  ACIA_TX_DATA (write)
                      (  turbo9_boot.asm):00071         ; FF01          GPI PORT          (read)
                      (  turbo9_boot.asm):00072         ; FF00          GPO PORT          (read)  /  GPO_PORT    (write)
                      (  turbo9_boot.asm):00073         ;
                      (  turbo9_boot.asm):00074         ; Initialized RAM: FEFF - 0000
                      (  turbo9_boot.asm):00075         ;
                      (  turbo9_boot.asm):00076         
     FF03             (  turbo9_boot.asm):00077         acia_status equ   $ff03
     FF02             (  turbo9_boot.asm):00078         acia_data   equ   $ff02
     FF01             (  turbo9_boot.asm):00079         gpi_port    equ   $ff01
     FF00             (  turbo9_boot.asm):00080         gpo_port    equ   $ff00
                      (  turbo9_boot.asm):00081         
                      (  turbo9_boot.asm):00082         
     FD00             (  turbo9_boot.asm):00083         boot_start  equ   $fd00       ; bootloader location
     FD00             (  turbo9_boot.asm):00084         boot_stack  equ   boot_start  ; stack location
                      (  turbo9_boot.asm):00085         
                      (  turbo9_boot.asm):00086         
                      (  turbo9_boot.asm):00087         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00088         ;                            Main Program
                      (  turbo9_boot.asm):00089         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00090         
                      (  turbo9_boot.asm):00091         
                      (  turbo9_boot.asm):00092         ; //////////////////// Start of bootloader
                      (  turbo9_boot.asm):00093         ; //
                      (  turbo9_boot.asm):00094           org   boot_start
                      (  turbo9_boot.asm):00095         
FD00 10CEFD00         (  turbo9_boot.asm):00096           lds   #boot_stack   ; set stack point
                      (  turbo9_boot.asm):00097         
FD04 7FFF00           (  turbo9_boot.asm):00098           clr   gpo_port  ; clear outport to communicate with TB
                      (  turbo9_boot.asm):00099         
                      (  turbo9_boot.asm):00100           ; B = general purpose
                      (  turbo9_boot.asm):00101           ; S = stack pointer
                      (  turbo9_boot.asm):00102         
                      (  turbo9_boot.asm):00103           ; A = byte_cnt,     S1 record byte count
                      (  turbo9_boot.asm):00104           ; X = checksum,
                      (  turbo9_boot.asm):00105           ; Y = write_addr,   Write address
                      (  turbo9_boot.asm):00106           ; U = total_bytes,  Total bytes written
                      (  turbo9_boot.asm):00107           
FD07 8E0000           (  turbo9_boot.asm):00108           ldx   #$0000        ; clear checksum
FD0A 1F13             (  turbo9_boot.asm):00109           tfr   x,u           ; clear total_bytes
                      (  turbo9_boot.asm):00110         
FD0C CCFDF2           (  turbo9_boot.asm):00111           ldd   #string_prompt
FD0F BDFE88           (  turbo9_boot.asm):00112           jsr   print_string
                      (  turbo9_boot.asm):00113          
                      (  turbo9_boot.asm):00114         ; //////////////////// Top of main Loop
                      (  turbo9_boot.asm):00115         ; //
FD12                  (  turbo9_boot.asm):00116         main_loop
FD12 BDFE4A           (  turbo9_boot.asm):00117           jsr   getchar_b
                      (  turbo9_boot.asm):00118         
FD15 C153             (  turbo9_boot.asm):00119           cmpb  #'S'
FD17 26F9             (  turbo9_boot.asm):00120           bne   main_loop
                      (  turbo9_boot.asm):00121         
FD19 BDFE4A           (  turbo9_boot.asm):00122           jsr   getchar_b
                      (  turbo9_boot.asm):00123         
FD1C C130             (  turbo9_boot.asm):00124           cmpb  #'0'
FD1E 270A             (  turbo9_boot.asm):00125           beq   s0_record
                      (  turbo9_boot.asm):00126         
FD20 C131             (  turbo9_boot.asm):00127           cmpb  #'1'
FD22 2725             (  turbo9_boot.asm):00128           beq   s1_record
                      (  turbo9_boot.asm):00129         
FD24 C139             (  turbo9_boot.asm):00130           cmpb  #'9'
FD26 2741             (  turbo9_boot.asm):00131           beq   s9_record
                      (  turbo9_boot.asm):00132         
FD28 20E8             (  turbo9_boot.asm):00133           bra   main_loop
                      (  turbo9_boot.asm):00134         
                      (  turbo9_boot.asm):00135         
                      (  turbo9_boot.asm):00136         ; //////////////////// S0 record
                      (  turbo9_boot.asm):00137         ; //
FD2A                  (  turbo9_boot.asm):00138         s0_record
FD2A 3084             (  turbo9_boot.asm):00139           leax  ,x            ; checksum still ok?
FD2C 26E4             (  turbo9_boot.asm):00140           bne   main_loop
FD2E BDFDC0           (  turbo9_boot.asm):00141           jsr   put_len_in_a
FD31 BDFDCD           (  turbo9_boot.asm):00142           jsr   put_addr_in_y
FD34                  (  turbo9_boot.asm):00143         s0r_loop
FD34 BDFE5C           (  turbo9_boot.asm):00144           jsr   gethex_byte
FD37 3085             (  turbo9_boot.asm):00145           leax  b,x           ; add_checksum
FD39 BDFE7A           (  turbo9_boot.asm):00146           jsr   putchar_b
FD3C 4A               (  turbo9_boot.asm):00147           deca                ; dec byte_cnt
FD3D 26F5             (  turbo9_boot.asm):00148           bne   s0r_loop
FD3F BDFDDF           (  turbo9_boot.asm):00149           jsr   calc_checksum_x
FD42 C620             (  turbo9_boot.asm):00150           ldb   #' '
FD44 BDFE7A           (  turbo9_boot.asm):00151           jsr   putchar_b     ; Print a space
FD47 20C9             (  turbo9_boot.asm):00152           bra   main_loop
                      (  turbo9_boot.asm):00153          
                      (  turbo9_boot.asm):00154         
                      (  turbo9_boot.asm):00155         ; //////////////////// S1 record
                      (  turbo9_boot.asm):00156         ; //
FD49                  (  turbo9_boot.asm):00157         s1_record
FD49 3084             (  turbo9_boot.asm):00158           leax  ,x            ; checksum still ok?
FD4B 26C5             (  turbo9_boot.asm):00159           bne   main_loop
FD4D BDFDC0           (  turbo9_boot.asm):00160           jsr   put_len_in_a
FD50 BDFDCD           (  turbo9_boot.asm):00161           jsr   put_addr_in_y
FD53                  (  turbo9_boot.asm):00162         s1r_loop
FD53 BDFE5C           (  turbo9_boot.asm):00163           jsr   gethex_byte
FD56 3085             (  turbo9_boot.asm):00164           leax  b,x           ; add_checksum
FD58 E7A0             (  turbo9_boot.asm):00165           stb   ,y+           ; write byte to write_addr; write_addr + 1
FD5A 3341             (  turbo9_boot.asm):00166           leau  1,u           ; U = total_bytes + 1
FD5C 4A               (  turbo9_boot.asm):00167           deca                ; dec byte_cnt
FD5D 26F4             (  turbo9_boot.asm):00168           bne   s1r_loop
FD5F BDFDDF           (  turbo9_boot.asm):00169           jsr   calc_checksum_x
FD62 C62E             (  turbo9_boot.asm):00170           ldb   #'.'
FD64 BDFE7A           (  turbo9_boot.asm):00171           jsr   putchar_b     ; Print progress bar
FD67 20A9             (  turbo9_boot.asm):00172           bra   main_loop
                      (  turbo9_boot.asm):00173         
                      (  turbo9_boot.asm):00174         
                      (  turbo9_boot.asm):00175         ; //////////////////// S9 record
                      (  turbo9_boot.asm):00176         ; //
FD69                  (  turbo9_boot.asm):00177         s9_record
FD69 3084             (  turbo9_boot.asm):00178           leax  ,x            ; checksum still ok?
FD6B 2612             (  turbo9_boot.asm):00179           bne   bootload_done
FD6D BDFDC0           (  turbo9_boot.asm):00180           jsr   put_len_in_a
FD70 BDFDCD           (  turbo9_boot.asm):00181           jsr   put_addr_in_y
FD73 BDFDDF           (  turbo9_boot.asm):00182           jsr   calc_checksum_x
FD76                  (  turbo9_boot.asm):00183         s9r_lf
FD76 BDFE4A           (  turbo9_boot.asm):00184           jsr   getchar_b
FD79 C10A             (  turbo9_boot.asm):00185           cmpb  #$0a
FD7B 26F9             (  turbo9_boot.asm):00186           bne   s9r_lf        ; strip the last LF from the data stream
FD7D 2000             (  turbo9_boot.asm):00187           bra   bootload_done
                      (  turbo9_boot.asm):00188           
                      (  turbo9_boot.asm):00189         
                      (  turbo9_boot.asm):00190         ; //////////////////// Bootloader done
                      (  turbo9_boot.asm):00191         ; //
FD7F                  (  turbo9_boot.asm):00192         bootload_done
FD7F CCFE0F           (  turbo9_boot.asm):00193           ldd   #string_checksum
FD82 BDFE88           (  turbo9_boot.asm):00194           jsr   print_string
FD85 3084             (  turbo9_boot.asm):00195           leax  ,x            ; checksum ok?
FD87 2709             (  turbo9_boot.asm):00196           beq   bootload_good
FD89 CCFE22           (  turbo9_boot.asm):00197           ldd   #string_fail
FD8C BDFE88           (  turbo9_boot.asm):00198           jsr   print_string
FD8F 7EFD00           (  turbo9_boot.asm):00199           jmp   boot_start
FD92                  (  turbo9_boot.asm):00200         bootload_good
FD92 CCFE27           (  turbo9_boot.asm):00201           ldd   #string_pass_total_bytes
FD95 BDFE88           (  turbo9_boot.asm):00202           jsr   print_string
FD98 1F30             (  turbo9_boot.asm):00203           tfr   u,d           ; U = total_bytes
FD9A BDFEA0           (  turbo9_boot.asm):00204           jsr   puthex_16bit
FD9D CCFE3C           (  turbo9_boot.asm):00205           ldd   #string_jsr
FDA0 BDFE88           (  turbo9_boot.asm):00206           jsr   print_string
FDA3 1F20             (  turbo9_boot.asm):00207           tfr   y,d           ; Y = loaded program start address
FDA5 BDFEA0           (  turbo9_boot.asm):00208           jsr   puthex_16bit
FDA8 CCFE48           (  turbo9_boot.asm):00209           ldd   #string_line_feed
FDAB BDFE88           (  turbo9_boot.asm):00210           jsr   print_string
FDAE BDFE88           (  turbo9_boot.asm):00211           jsr   print_string
FDB1                  (  turbo9_boot.asm):00212         call_prog_start
FDB1 C601             (  turbo9_boot.asm):00213           ldb   #$01
FDB3 F7FF00           (  turbo9_boot.asm):00214           stb   gpo_port    ; set outport[0] = 1 to tell TB test has begun 
FDB6 ADA4             (  turbo9_boot.asm):00215           jsr   ,y          ; jump/call to loaded program at address Y 
                      (  turbo9_boot.asm):00216           ;
                      (  turbo9_boot.asm):00217           ; Run the loaded program!
                      (  turbo9_boot.asm):00218           ;
FDB8                  (  turbo9_boot.asm):00219         boot_return
FDB8                  (  turbo9_boot.asm):00220         boot_return_io_lib
FDB8 C602             (  turbo9_boot.asm):00221           ldb   #$02
FDBA F7FF00           (  turbo9_boot.asm):00222           stb   gpo_port    ;  set outport[1] = 1 to tell TB test has finished
FDBD 7EFD00           (  turbo9_boot.asm):00223           jmp   boot_start
                      (  turbo9_boot.asm):00224         
                      (  turbo9_boot.asm):00225         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00226         
                      (  turbo9_boot.asm):00227         
                      (  turbo9_boot.asm):00228         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00229         ;                            Helper Functions
                      (  turbo9_boot.asm):00230         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00231         
                      (  turbo9_boot.asm):00232         
                      (  turbo9_boot.asm):00233         ; //////////////////// Get length, put in A
                      (  turbo9_boot.asm):00234         ; //
FDC0                  (  turbo9_boot.asm):00235         put_len_in_a
                      (  turbo9_boot.asm):00236           ; put length in A, update checksum in X.
FDC0 3404             (  turbo9_boot.asm):00237           pshs  b
FDC2 BDFE5C           (  turbo9_boot.asm):00238           jsr   gethex_byte   ; Read length
FDC5 3085             (  turbo9_boot.asm):00239           leax  b,x           ; add_checksum
FDC7 C003             (  turbo9_boot.asm):00240           subb  #3            ; minus 16bit address & checksum equals number of data bytes
FDC9 1F98             (  turbo9_boot.asm):00241           tfr   b,a           ; put byte_cnt in A
FDCB 3584             (  turbo9_boot.asm):00242           puls  b,pc
                      (  turbo9_boot.asm):00243         
                      (  turbo9_boot.asm):00244         
                      (  turbo9_boot.asm):00245         ; //////////////////// Get address, put in Y
                      (  turbo9_boot.asm):00246         ; //
FDCD                  (  turbo9_boot.asm):00247         put_addr_in_y
                      (  turbo9_boot.asm):00248           ; put address in Y, update checksum in X.
FDCD 3406             (  turbo9_boot.asm):00249           pshs  a,b
FDCF BDFE5C           (  turbo9_boot.asm):00250           jsr   gethex_byte
FDD2 3085             (  turbo9_boot.asm):00251           leax  b,x           ; add_checksum
FDD4 1F98             (  turbo9_boot.asm):00252           tfr   b,a           ; put write_addr[15:8] in A
FDD6 BDFE5C           (  turbo9_boot.asm):00253           jsr   gethex_byte
FDD9 3085             (  turbo9_boot.asm):00254           leax  b,x           ; add_checksum
FDDB 1F02             (  turbo9_boot.asm):00255           tfr   d,y           ; Y = write_addr
FDDD 3586             (  turbo9_boot.asm):00256           puls  a,b,pc
                      (  turbo9_boot.asm):00257         
                      (  turbo9_boot.asm):00258         
                      (  turbo9_boot.asm):00259         ; //////////////////// Get checksum, compare to X
                      (  turbo9_boot.asm):00260         ; //
FDDF                  (  turbo9_boot.asm):00261         calc_checksum_x
                      (  turbo9_boot.asm):00262           ; the S1 checksum should equal the one's complement of our running checksum in x[7:0]
FDDF 3406             (  turbo9_boot.asm):00263           pshs  a,b
FDE1 BDFE5C           (  turbo9_boot.asm):00264           jsr   gethex_byte   ; read S1 checksum
FDE4 E7E2             (  turbo9_boot.asm):00265           stb   ,-s           ; push S1 checksum onto stack
FDE6 1F10             (  turbo9_boot.asm):00266           tfr   x,d
FDE8 E8E4             (  turbo9_boot.asm):00267           eorb  ,s            ; B = $FF if correct
FDEA 5C               (  turbo9_boot.asm):00268           incb                ; B = $00 if correct
FDEB 4F               (  turbo9_boot.asm):00269           clra
FDEC 1F01             (  turbo9_boot.asm):00270           tfr   d,x           ; X = $0000 if correct
FDEE 3261             (  turbo9_boot.asm):00271           leas  1,s           ; clean up stack
FDF0 3586             (  turbo9_boot.asm):00272           puls  a,b,pc
                      (  turbo9_boot.asm):00273         
