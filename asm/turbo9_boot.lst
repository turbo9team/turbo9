FD27 50415353         (  turbo9_boot.asm):00313           fcc  "PASS"
FD2B 0A               (  turbo9_boot.asm):00314           fcb  $0a
FD2C 3E20546F74616C20 (  turbo9_boot.asm):00315           fcc  "> Total bytes $"
     62797465732024
FD3B 00               (  turbo9_boot.asm):00316           fcb  $00
                      (  turbo9_boot.asm):00317         
