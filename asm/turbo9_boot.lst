                      (  turbo9_boot.asm):00045         ;
                      (  turbo9_boot.asm):00046         ; Turbo9 S19 Bootloader
                      (  turbo9_boot.asm):00047         ;
                      (  turbo9_boot.asm):00048         ; Kevin Phillipson
                      (  turbo9_boot.asm):00049         ;
                      (  turbo9_boot.asm):00050         
                      (  turbo9_boot.asm):00051         ; //////////// Memory Map
                      (  turbo9_boot.asm):00052         ;
                      (  turbo9_boot.asm):00053         ;
                      (  turbo9_boot.asm):00054         ; Boot ROM (Vector Table): FFFF - FFF0
                      (  turbo9_boot.asm):00055         ;
                      (  turbo9_boot.asm):00056         ; FFFE : FFFF   RESET_VECTOR
                      (  turbo9_boot.asm):00057         ; FFFC : FFFD   NMI_VECTOR
                      (  turbo9_boot.asm):00058         ; FFFA : FFFB   SWI_VECTOR
                      (  turbo9_boot.asm):00059         ; FFF8 : FFF9   IRQ_VECTOR
                      (  turbo9_boot.asm):00060         ; FFF6 : FFF7   FIRQ_VECTOR
                      (  turbo9_boot.asm):00061         ; FFF4 : FFF5   SWI2_VECTOR
                      (  turbo9_boot.asm):00062         ; FFF2 : FFF3   SWI3_VECTOR
                      (  turbo9_boot.asm):00063         ; FFF0 : FFF1   RESERVED_VECTOR
                      (  turbo9_boot.asm):00064         ;
                      (  turbo9_boot.asm):00065         ;
                      (  turbo9_boot.asm):00066         ; I/O Space: FF09 - FF00
                      (  turbo9_boot.asm):00067         ;
                      (  turbo9_boot.asm):00068         ; FF09          ROM_ENABLE        (read)  /  ROM_ENABLE   (write)
                      (  turbo9_boot.asm):00069         ; FF08          CLK_CNT_CTRL[1:0] (read)  /  CLK_CNT_CTRL (write)
                      (  turbo9_boot.asm):00070         ; FF04 : FF07   CLK_CNT[31:0]     (read)
                      (  turbo9_boot.asm):00071         ; FF03          ACIA_STATUS       (read)
                      (  turbo9_boot.asm):00072         ; FF02          ACIA_RX_DATA      (read)  /  ACIA_TX_DATA (write)
                      (  turbo9_boot.asm):00073         ; FF01          GPI PORT          (read)
                      (  turbo9_boot.asm):00074         ; FF00          GPO PORT          (read)  /  GPO_PORT    (write)
                      (  turbo9_boot.asm):00075         ;
                      (  turbo9_boot.asm):00076         ;
                      (  turbo9_boot.asm):00077         ; Boot ROM (RAM overlay when enabled): FFEF - FC00
                      (  turbo9_boot.asm):00078         ;
                      (  turbo9_boot.asm):00079         ;
                      (  turbo9_boot.asm):00080         ; General RAM: FBFF - 0000
                      (  turbo9_boot.asm):00081         ;
                      (  turbo9_boot.asm):00082         
     FF03             (  turbo9_boot.asm):00083         acia_status equ   $ff03
     FF02             (  turbo9_boot.asm):00084         acia_data   equ   $ff02
     FF01             (  turbo9_boot.asm):00085         gpi_port    equ   $ff01
     FF00             (  turbo9_boot.asm):00086         gpo_port    equ   $ff00
                      (  turbo9_boot.asm):00087         
                      (  turbo9_boot.asm):00088         
     FC00             (  turbo9_boot.asm):00089         boot_start  equ   $fc00       ; bootloader location -- the mirrored alias of
                      (  turbo9_boot.asm):00090                                        ; the real FE00 Boot ROM window (syncrom only
                      (  turbo9_boot.asm):00091                                        ; decodes 9 address bits, so FC00-FDFF reads
                      (  turbo9_boot.asm):00092                                        ; back the same 512 bytes as FE00-FFFF); using
                      (  turbo9_boot.asm):00093                                        ; this alias keeps the whole image contiguous
                      (  turbo9_boot.asm):00094                                        ; since it never crosses the FF00-FF09 I/O gap
     FBFF             (  turbo9_boot.asm):00095         boot_stack  equ   $fbff       ; must stay below FC00 -- that range reads ROM,
                      (  turbo9_boot.asm):00096                                        ; not RAM, while rom_en is set, so PSHS/RTS
                      (  turbo9_boot.asm):00097                                        ; there would read back stale ROM bytes
                      (  turbo9_boot.asm):00098         
                      (  turbo9_boot.asm):00099         
                      (  turbo9_boot.asm):00100         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00101         ;                            Main Program
                      (  turbo9_boot.asm):00102         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00103         
                      (  turbo9_boot.asm):00104         
                      (  turbo9_boot.asm):00105         ; //////////////////// Start of bootloader
                      (  turbo9_boot.asm):00106         ; //
                      (  turbo9_boot.asm):00107           org   boot_start
                      (  turbo9_boot.asm):00108         
FC00 10CEFBFF         (  turbo9_boot.asm):00109           lds   #boot_stack   ; set stack point
                      (  turbo9_boot.asm):00110         
FC04 7FFF00           (  turbo9_boot.asm):00111           clr   gpo_port  ; clear outport to communicate with TB
                      (  turbo9_boot.asm):00112         
                      (  turbo9_boot.asm):00113           ; B = general purpose
                      (  turbo9_boot.asm):00114           ; S = stack pointer
                      (  turbo9_boot.asm):00115         
                      (  turbo9_boot.asm):00116           ; A = byte_cnt,     S1 record byte count
                      (  turbo9_boot.asm):00117           ; X = checksum,
                      (  turbo9_boot.asm):00118           ; Y = write_addr,   Write address
                      (  turbo9_boot.asm):00119           ; U = total_bytes,  Total bytes written
                      (  turbo9_boot.asm):00120           
FC07 8E0000           (  turbo9_boot.asm):00121           ldx   #$0000        ; clear checksum
FC0A 1F13             (  turbo9_boot.asm):00122           tfr   x,u           ; clear total_bytes
                      (  turbo9_boot.asm):00123         
FC0C CCFCF2           (  turbo9_boot.asm):00124           ldd   #string_prompt
FC0F BDFD88           (  turbo9_boot.asm):00125           jsr   print_string
                      (  turbo9_boot.asm):00126          
                      (  turbo9_boot.asm):00127         ; //////////////////// Top of main Loop
                      (  turbo9_boot.asm):00128         ; //
FC12                  (  turbo9_boot.asm):00129         main_loop
FC12 BDFD4A           (  turbo9_boot.asm):00130           jsr   getchar_b
                      (  turbo9_boot.asm):00131         
FC15 C153             (  turbo9_boot.asm):00132           cmpb  #'S'
FC17 26F9             (  turbo9_boot.asm):00133           bne   main_loop
                      (  turbo9_boot.asm):00134         
FC19 BDFD4A           (  turbo9_boot.asm):00135           jsr   getchar_b
                      (  turbo9_boot.asm):00136         
FC1C C130             (  turbo9_boot.asm):00137           cmpb  #'0'
FC1E 270A             (  turbo9_boot.asm):00138           beq   s0_record
                      (  turbo9_boot.asm):00139         
FC20 C131             (  turbo9_boot.asm):00140           cmpb  #'1'
FC22 2725             (  turbo9_boot.asm):00141           beq   s1_record
                      (  turbo9_boot.asm):00142         
FC24 C139             (  turbo9_boot.asm):00143           cmpb  #'9'
FC26 2741             (  turbo9_boot.asm):00144           beq   s9_record
                      (  turbo9_boot.asm):00145         
FC28 20E8             (  turbo9_boot.asm):00146           bra   main_loop
                      (  turbo9_boot.asm):00147         
                      (  turbo9_boot.asm):00148         
                      (  turbo9_boot.asm):00149         ; //////////////////// S0 record
                      (  turbo9_boot.asm):00150         ; //
FC2A                  (  turbo9_boot.asm):00151         s0_record
FC2A 3084             (  turbo9_boot.asm):00152           leax  ,x            ; checksum still ok?
FC2C 26E4             (  turbo9_boot.asm):00153           bne   main_loop
FC2E BDFCC0           (  turbo9_boot.asm):00154           jsr   put_len_in_a
FC31 BDFCCD           (  turbo9_boot.asm):00155           jsr   put_addr_in_y
FC34                  (  turbo9_boot.asm):00156         s0r_loop
FC34 BDFD5C           (  turbo9_boot.asm):00157           jsr   gethex_byte
FC37 3085             (  turbo9_boot.asm):00158           leax  b,x           ; add_checksum
FC39 BDFD7A           (  turbo9_boot.asm):00159           jsr   putchar_b
FC3C 4A               (  turbo9_boot.asm):00160           deca                ; dec byte_cnt
FC3D 26F5             (  turbo9_boot.asm):00161           bne   s0r_loop
FC3F BDFCDF           (  turbo9_boot.asm):00162           jsr   calc_checksum_x
FC42 C620             (  turbo9_boot.asm):00163           ldb   #' '
FC44 BDFD7A           (  turbo9_boot.asm):00164           jsr   putchar_b     ; Print a space
FC47 20C9             (  turbo9_boot.asm):00165           bra   main_loop
                      (  turbo9_boot.asm):00166          
                      (  turbo9_boot.asm):00167         
                      (  turbo9_boot.asm):00168         ; //////////////////// S1 record
                      (  turbo9_boot.asm):00169         ; //
FC49                  (  turbo9_boot.asm):00170         s1_record
FC49 3084             (  turbo9_boot.asm):00171           leax  ,x            ; checksum still ok?
FC4B 26C5             (  turbo9_boot.asm):00172           bne   main_loop
FC4D BDFCC0           (  turbo9_boot.asm):00173           jsr   put_len_in_a
FC50 BDFCCD           (  turbo9_boot.asm):00174           jsr   put_addr_in_y
FC53                  (  turbo9_boot.asm):00175         s1r_loop
FC53 BDFD5C           (  turbo9_boot.asm):00176           jsr   gethex_byte
FC56 3085             (  turbo9_boot.asm):00177           leax  b,x           ; add_checksum
FC58 E7A0             (  turbo9_boot.asm):00178           stb   ,y+           ; write byte to write_addr; write_addr + 1
FC5A 3341             (  turbo9_boot.asm):00179           leau  1,u           ; U = total_bytes + 1
FC5C 4A               (  turbo9_boot.asm):00180           deca                ; dec byte_cnt
FC5D 26F4             (  turbo9_boot.asm):00181           bne   s1r_loop
FC5F BDFCDF           (  turbo9_boot.asm):00182           jsr   calc_checksum_x
FC62 C62E             (  turbo9_boot.asm):00183           ldb   #'.'
FC64 BDFD7A           (  turbo9_boot.asm):00184           jsr   putchar_b     ; Print progress bar
FC67 20A9             (  turbo9_boot.asm):00185           bra   main_loop
                      (  turbo9_boot.asm):00186         
                      (  turbo9_boot.asm):00187         
                      (  turbo9_boot.asm):00188         ; //////////////////// S9 record
                      (  turbo9_boot.asm):00189         ; //
FC69                  (  turbo9_boot.asm):00190         s9_record
FC69 3084             (  turbo9_boot.asm):00191           leax  ,x            ; checksum still ok?
FC6B 2612             (  turbo9_boot.asm):00192           bne   bootload_done
FC6D BDFCC0           (  turbo9_boot.asm):00193           jsr   put_len_in_a
FC70 BDFCCD           (  turbo9_boot.asm):00194           jsr   put_addr_in_y
FC73 BDFCDF           (  turbo9_boot.asm):00195           jsr   calc_checksum_x
FC76                  (  turbo9_boot.asm):00196         s9r_lf
FC76 BDFD4A           (  turbo9_boot.asm):00197           jsr   getchar_b
FC79 C10A             (  turbo9_boot.asm):00198           cmpb  #$0a
FC7B 26F9             (  turbo9_boot.asm):00199           bne   s9r_lf        ; strip the last LF from the data stream
FC7D 2000             (  turbo9_boot.asm):00200           bra   bootload_done
                      (  turbo9_boot.asm):00201           
                      (  turbo9_boot.asm):00202         
                      (  turbo9_boot.asm):00203         ; //////////////////// Bootloader done
                      (  turbo9_boot.asm):00204         ; //
FC7F                  (  turbo9_boot.asm):00205         bootload_done
FC7F CCFD0F           (  turbo9_boot.asm):00206           ldd   #string_checksum
FC82 BDFD88           (  turbo9_boot.asm):00207           jsr   print_string
FC85 3084             (  turbo9_boot.asm):00208           leax  ,x            ; checksum ok?
FC87 2709             (  turbo9_boot.asm):00209           beq   bootload_good
FC89 CCFD22           (  turbo9_boot.asm):00210           ldd   #string_fail
FC8C BDFD88           (  turbo9_boot.asm):00211           jsr   print_string
FC8F 7EFC00           (  turbo9_boot.asm):00212           jmp   boot_start
FC92                  (  turbo9_boot.asm):00213         bootload_good
FC92 CCFD27           (  turbo9_boot.asm):00214           ldd   #string_pass_total_bytes
FC95 BDFD88           (  turbo9_boot.asm):00215           jsr   print_string
FC98 1F30             (  turbo9_boot.asm):00216           tfr   u,d           ; U = total_bytes
FC9A BDFDA0           (  turbo9_boot.asm):00217           jsr   puthex_16bit
FC9D CCFD3C           (  turbo9_boot.asm):00218           ldd   #string_jsr
FCA0 BDFD88           (  turbo9_boot.asm):00219           jsr   print_string
FCA3 1F20             (  turbo9_boot.asm):00220           tfr   y,d           ; Y = loaded program start address
FCA5 BDFDA0           (  turbo9_boot.asm):00221           jsr   puthex_16bit
FCA8 CCFD48           (  turbo9_boot.asm):00222           ldd   #string_line_feed
FCAB BDFD88           (  turbo9_boot.asm):00223           jsr   print_string
FCAE BDFD88           (  turbo9_boot.asm):00224           jsr   print_string
FCB1                  (  turbo9_boot.asm):00225         call_prog_start
FCB1 C601             (  turbo9_boot.asm):00226           ldb   #$01
FCB3 F7FF00           (  turbo9_boot.asm):00227           stb   gpo_port    ; set outport[0] = 1 to tell TB test has begun 
FCB6 ADA4             (  turbo9_boot.asm):00228           jsr   ,y          ; jump/call to loaded program at address Y 
                      (  turbo9_boot.asm):00229           ;
                      (  turbo9_boot.asm):00230           ; Run the loaded program!
                      (  turbo9_boot.asm):00231           ;
FCB8                  (  turbo9_boot.asm):00232         boot_return
FCB8                  (  turbo9_boot.asm):00233         boot_return_io_lib
FCB8 C602             (  turbo9_boot.asm):00234           ldb   #$02
FCBA F7FF00           (  turbo9_boot.asm):00235           stb   gpo_port    ;  set outport[1] = 1 to tell TB test has finished
FCBD 7EFC00           (  turbo9_boot.asm):00236           jmp   boot_start
                      (  turbo9_boot.asm):00237         
                      (  turbo9_boot.asm):00238         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00239         
                      (  turbo9_boot.asm):00240         
                      (  turbo9_boot.asm):00241         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00242         ;                            Helper Functions
                      (  turbo9_boot.asm):00243         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00244         
                      (  turbo9_boot.asm):00245         
                      (  turbo9_boot.asm):00246         ; //////////////////// Get length, put in A
                      (  turbo9_boot.asm):00247         ; //
FCC0                  (  turbo9_boot.asm):00248         put_len_in_a
                      (  turbo9_boot.asm):00249           ; put length in A, update checksum in X.
FCC0 3404             (  turbo9_boot.asm):00250           pshs  b
FCC2 BDFD5C           (  turbo9_boot.asm):00251           jsr   gethex_byte   ; Read length
FCC5 3085             (  turbo9_boot.asm):00252           leax  b,x           ; add_checksum
FCC7 C003             (  turbo9_boot.asm):00253           subb  #3            ; minus 16bit address & checksum equals number of data bytes
FCC9 1F98             (  turbo9_boot.asm):00254           tfr   b,a           ; put byte_cnt in A
FCCB 3584             (  turbo9_boot.asm):00255           puls  b,pc
                      (  turbo9_boot.asm):00256         
                      (  turbo9_boot.asm):00257         
                      (  turbo9_boot.asm):00258         ; //////////////////// Get address, put in Y
                      (  turbo9_boot.asm):00259         ; //
FCCD                  (  turbo9_boot.asm):00260         put_addr_in_y
                      (  turbo9_boot.asm):00261           ; put address in Y, update checksum in X.
FCCD 3406             (  turbo9_boot.asm):00262           pshs  a,b
FCCF BDFD5C           (  turbo9_boot.asm):00263           jsr   gethex_byte
FCD2 3085             (  turbo9_boot.asm):00264           leax  b,x           ; add_checksum
FCD4 1F98             (  turbo9_boot.asm):00265           tfr   b,a           ; put write_addr[15:8] in A
FCD6 BDFD5C           (  turbo9_boot.asm):00266           jsr   gethex_byte
FCD9 3085             (  turbo9_boot.asm):00267           leax  b,x           ; add_checksum
FCDB 1F02             (  turbo9_boot.asm):00268           tfr   d,y           ; Y = write_addr
FCDD 3586             (  turbo9_boot.asm):00269           puls  a,b,pc
                      (  turbo9_boot.asm):00270         
                      (  turbo9_boot.asm):00271         
                      (  turbo9_boot.asm):00272         ; //////////////////// Get checksum, compare to X
                      (  turbo9_boot.asm):00273         ; //
FCDF                  (  turbo9_boot.asm):00274         calc_checksum_x
                      (  turbo9_boot.asm):00275           ; the S1 checksum should equal the one's complement of our running checksum in x[7:0]
FCDF 3406             (  turbo9_boot.asm):00276           pshs  a,b
FCE1 BDFD5C           (  turbo9_boot.asm):00277           jsr   gethex_byte   ; read S1 checksum
FCE4 E7E2             (  turbo9_boot.asm):00278           stb   ,-s           ; push S1 checksum onto stack
FCE6 1F10             (  turbo9_boot.asm):00279           tfr   x,d
FCE8 E8E4             (  turbo9_boot.asm):00280           eorb  ,s            ; B = $FF if correct
FCEA 5C               (  turbo9_boot.asm):00281           incb                ; B = $00 if correct
FCEB 4F               (  turbo9_boot.asm):00282           clra
FCEC 1F01             (  turbo9_boot.asm):00283           tfr   d,x           ; X = $0000 if correct
FCEE 3261             (  turbo9_boot.asm):00284           leas  1,s           ; clean up stack
FCF0 3586             (  turbo9_boot.asm):00285           puls  a,b,pc
                      (  turbo9_boot.asm):00286         
                      (  turbo9_boot.asm):00287         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00288         
                      (  turbo9_boot.asm):00289         
                      (  turbo9_boot.asm):00290         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00291         ;                              Data Block
                      (  turbo9_boot.asm):00292         ; ////////////////////////////////////////////////////////////////////////////
                      (  turbo9_boot.asm):00293         
FCF2                  (  turbo9_boot.asm):00294         string_prompt
FCF2 0A               (  turbo9_boot.asm):00295           fcb  $0a
FCF3 0A               (  turbo9_boot.asm):00296           fcb  $0a
