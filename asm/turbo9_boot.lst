     2053313920426F6F
     746C6F61646572
FD0B 0A               (  turbo9_boot.asm):00298           fcb  $0a
FD0C 3E20             (  turbo9_boot.asm):00299           fcc  "> "
FD0E 00               (  turbo9_boot.asm):00300           fcb  $00
                      (  turbo9_boot.asm):00301         
FD0F                  (  turbo9_boot.asm):00302         string_checksum
FD0F 20646F6E6521     (  turbo9_boot.asm):00303           fcc  " done!"
FD15 0A               (  turbo9_boot.asm):00304           fcb  $0a
FD16 3E20436865636B73 (  turbo9_boot.asm):00305           fcc  "> Checksum "
     756D20
FD21 00               (  turbo9_boot.asm):00306           fcb  $00
                      (  turbo9_boot.asm):00307         
FD22                  (  turbo9_boot.asm):00308         string_fail
FD22 4641494C         (  turbo9_boot.asm):00309           fcc  "FAIL"
FD26 00               (  turbo9_boot.asm):00310           fcb  $00
                      (  turbo9_boot.asm):00311         
