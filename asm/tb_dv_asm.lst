                      (    tb_dv_asm.asm):00035         ; Engineer: Kevin Phillipson
                      (    tb_dv_asm.asm):00036         ; Description: Template assemply program used by the DV testbench
                      (    tb_dv_asm.asm):00037         ;
                      (    tb_dv_asm.asm):00038         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00039         ; History:
                      (    tb_dv_asm.asm):00040         ; 07.14.2023 - Kevin Phillipson
                      (    tb_dv_asm.asm):00041         ;   File header added
                      (    tb_dv_asm.asm):00042         ;
                      (    tb_dv_asm.asm):00043         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00044         ; [TURBO9_HEADER_END]
                      (    tb_dv_asm.asm):00045         
                      (    tb_dv_asm.asm):00046         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00047         ;                       Turbo9 / 6809 testbench program
                      (    tb_dv_asm.asm):00048         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00049         
     FF00             (    tb_dv_asm.asm):00050         gpo_port equ $ff00
                      (    tb_dv_asm.asm):00051         
                      (    tb_dv_asm.asm):00052           org  $fa00
                      (    tb_dv_asm.asm):00053         
                      (    tb_dv_asm.asm):00054         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00055         ;                    Testbench Program Start (S Stack Pointer)
                      (    tb_dv_asm.asm):00056         ; ////////////////////////////////////////////////////////////////////////////
FA00                  (    tb_dv_asm.asm):00057         start_s_ptr:
                      (    tb_dv_asm.asm):00058         
                      (    tb_dv_asm.asm):00059           ; initalize gpo_port[7:0] = 8'h00
FA00 7FFF00           (    tb_dv_asm.asm):00060           clr   >gpo_port
                      (    tb_dv_asm.asm):00061         
                      (    tb_dv_asm.asm):00062           ; Delay a few cycles
FA03 12               (    tb_dv_asm.asm):00063           nop
FA04 12               (    tb_dv_asm.asm):00064           nop
                      (    tb_dv_asm.asm):00065         
                      (    tb_dv_asm.asm):00066           ; set start flag (gpo_port[0] = 1'b1)
FA05 7CFF00           (    tb_dv_asm.asm):00067           inc   >gpo_port
                      (    tb_dv_asm.asm):00068         
                      (    tb_dv_asm.asm):00069           ; Use S as stack pointer
FA08 10CEFEF4         (    tb_dv_asm.asm):00070           lds   #init_stack_data
FA0C 35FF             (    tb_dv_asm.asm):00071           puls  pc,u,y,x,dp,b,a,cc ; pulling PC will jump to code_under_test
                      (    tb_dv_asm.asm):00072         
                      (    tb_dv_asm.asm):00073         
                      (    tb_dv_asm.asm):00074         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00075         ;                    Testbench Program Start (U Stack Pointer)
                      (    tb_dv_asm.asm):00076         ; ////////////////////////////////////////////////////////////////////////////
FA0E                  (    tb_dv_asm.asm):00077         start_u_ptr:
                      (    tb_dv_asm.asm):00078         
                      (    tb_dv_asm.asm):00079           ; initalize gpo_port[7:0] = 8'h00
FA0E 7FFF00           (    tb_dv_asm.asm):00080           clr   >gpo_port
                      (    tb_dv_asm.asm):00081         
                      (    tb_dv_asm.asm):00082           ; Delay a few cycles
FA11 12               (    tb_dv_asm.asm):00083           nop
FA12 12               (    tb_dv_asm.asm):00084           nop
                      (    tb_dv_asm.asm):00085         
                      (    tb_dv_asm.asm):00086           ; set start flag (gpo_port[0] = 1'b1)
FA13 7CFF00           (    tb_dv_asm.asm):00087           inc   >gpo_port
                      (    tb_dv_asm.asm):00088         
                      (    tb_dv_asm.asm):00089           ; Use U as stack pointer
FA16 CEFEF4           (    tb_dv_asm.asm):00090           ldu   #init_stack_data
FA19 37FF             (    tb_dv_asm.asm):00091           pulu  pc,s,y,x,dp,b,a,cc ; pulling PC will jump to code_under_test
                      (    tb_dv_asm.asm):00092         
                      (    tb_dv_asm.asm):00093         
                      (    tb_dv_asm.asm):00094         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00095         ;                     Testbench Program Done (S Stack Pointer)
                      (    tb_dv_asm.asm):00096         ; ////////////////////////////////////////////////////////////////////////////
FA1B                  (    tb_dv_asm.asm):00097         done_s_ptr
FA1B 34FF             (    tb_dv_asm.asm):00098           pshs  pc,u,y,x,dp,b,a,cc
                      (    tb_dv_asm.asm):00099         
                      (    tb_dv_asm.asm):00100           ; set done flag (gpo_port[1] = 1'b1)
FA1D 7CFF00           (    tb_dv_asm.asm):00101           inc   >gpo_port
                      (    tb_dv_asm.asm):00102         
FA20                  (    tb_dv_asm.asm):00103         done_s_ptr_loop:
FA20 12               (    tb_dv_asm.asm):00104           nop   ; make the PC change in sim model
FA21 20FD             (    tb_dv_asm.asm):00105           bra   done_s_ptr_loop
                      (    tb_dv_asm.asm):00106         
                      (    tb_dv_asm.asm):00107         
                      (    tb_dv_asm.asm):00108         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00109         ;                     Testbench Program Done (U Stack Pointer)
                      (    tb_dv_asm.asm):00110         ; ////////////////////////////////////////////////////////////////////////////
FA23                  (    tb_dv_asm.asm):00111         done_u_ptr
FA23 36FF             (    tb_dv_asm.asm):00112           pshu  pc,s,y,x,dp,b,a,cc
                      (    tb_dv_asm.asm):00113         
                      (    tb_dv_asm.asm):00114           ; set done flag (gpo_port[1] = 1'b1)
FA25 7CFF00           (    tb_dv_asm.asm):00115           inc   >gpo_port
                      (    tb_dv_asm.asm):00116         
FA28                  (    tb_dv_asm.asm):00117         done_u_ptr_loop:
FA28 12               (    tb_dv_asm.asm):00118           nop   ; make the PC change in sim model
FA29 20FD             (    tb_dv_asm.asm):00119           bra   done_u_ptr_loop
                      (    tb_dv_asm.asm):00120         
                      (    tb_dv_asm.asm):00121         
                      (    tb_dv_asm.asm):00122         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00123         ;                             Code Under Test
                      (    tb_dv_asm.asm):00124         ; ////////////////////////////////////////////////////////////////////////////
FA2B                  (    tb_dv_asm.asm):00125         code_under_test:
                      (    tb_dv_asm.asm):00126         
                      (    tb_dv_asm.asm):00127         ; replace the following with code to test
FA2B 7EFA1B           (    tb_dv_asm.asm):00128           jmp   done_s_ptr
                      (    tb_dv_asm.asm):00129         
                      (    tb_dv_asm.asm):00130           org code_under_test_mid-128+2
FC07                  (    tb_dv_asm.asm):00131         code_under_test_br_bwd
                      (    tb_dv_asm.asm):00132         ; the maximum range for branching backward
FC07 4C               (    tb_dv_asm.asm):00133           inca
FC08 7EFA1B           (    tb_dv_asm.asm):00134           jmp   done_s_ptr
                      (    tb_dv_asm.asm):00135         
                      (    tb_dv_asm.asm):00136           org code_under_test_mid-128+3
FC08                  (    tb_dv_asm.asm):00137         code_under_test_idx_pc8_bwd
                      (    tb_dv_asm.asm):00138         ; the maximum range for pc8 index backward
                      (    tb_dv_asm.asm):00139         
                      (    tb_dv_asm.asm):00140           org   (code_under_test+data_block_end)/2
FC85                  (    tb_dv_asm.asm):00141         code_under_test_mid
                      (    tb_dv_asm.asm):00142         ; a midpoint in the code/data block
FC85 2780             (    tb_dv_asm.asm):00143           beq   code_under_test_br_bwd
FC87 7EFA1B           (    tb_dv_asm.asm):00144           jmp   done_s_ptr
                      (    tb_dv_asm.asm):00145         
                      (    tb_dv_asm.asm):00146           org code_under_test_mid+127+2
FD06                  (    tb_dv_asm.asm):00147         code_under_test_br_fwd
                      (    tb_dv_asm.asm):00148         ; the maximum range for branching forward
FD06 5C               (    tb_dv_asm.asm):00149           incb
FD07 7EFA1B           (    tb_dv_asm.asm):00150           jmp   done_s_ptr
                      (    tb_dv_asm.asm):00151         
                      (    tb_dv_asm.asm):00152           org code_under_test_mid+127+3
FD07                  (    tb_dv_asm.asm):00153         code_under_test_idx_pc8_fwd
                      (    tb_dv_asm.asm):00154         ; the maximum range for pc8 index forward
                      (    tb_dv_asm.asm):00155         
                      (    tb_dv_asm.asm):00156         
                      (    tb_dv_asm.asm):00157         
                      (    tb_dv_asm.asm):00158         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00159         ;                               Data Block
                      (    tb_dv_asm.asm):00160         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00161         
FD07                  (    tb_dv_asm.asm):00162         data_addr:
FD07 7F               (    tb_dv_asm.asm):00163           fcb $7f
                      (    tb_dv_asm.asm):00164         
                      (    tb_dv_asm.asm):00165         
                      (    tb_dv_asm.asm):00166           org  stack_end-1
FEDF                  (    tb_dv_asm.asm):00167         data_block_last_byte:
                      (    tb_dv_asm.asm):00168           org  stack_end
FEE0                  (    tb_dv_asm.asm):00169         data_block_end:
                      (    tb_dv_asm.asm):00170         
                      (    tb_dv_asm.asm):00171         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00172         ;                            Stack (32 bytes)
                      (    tb_dv_asm.asm):00173         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00174         ; Used to load initial state and save run-time data for code under test
                      (    tb_dv_asm.asm):00175         ; and save the processor state after code under test complete
                      (    tb_dv_asm.asm):00176         
                      (    tb_dv_asm.asm):00177           org  io_block-32
FEE0                  (    tb_dv_asm.asm):00178         stack_end:
                      (    tb_dv_asm.asm):00179         
                      (    tb_dv_asm.asm):00180           org  io_block-12
FEF4                  (    tb_dv_asm.asm):00181         init_stack_data:
FEF4                  (    tb_dv_asm.asm):00182         init_cc:
FEF4 78               (    tb_dv_asm.asm):00183           fcb   $78   ;cc
FEF5                  (    tb_dv_asm.asm):00184         init_a:
FEF5 67               (    tb_dv_asm.asm):00185           fcb   $67   ;a
FEF6                  (    tb_dv_asm.asm):00186         init_b:
FEF6 56               (    tb_dv_asm.asm):00187           fcb   $56   ;b
FEF7                  (    tb_dv_asm.asm):00188         init_dp:
FEF7 FD               (    tb_dv_asm.asm):00189           fcb   data_addr/$100  ;dp
FEF8                  (    tb_dv_asm.asm):00190         init_x:
FEF8 3443             (    tb_dv_asm.asm):00191           fdb   $3443 ;x
FEFA                  (    tb_dv_asm.asm):00192         init_y:
FEFA 2332             (    tb_dv_asm.asm):00193           fdb   $2332 ;y
FEFC                  (    tb_dv_asm.asm):00194         init_u_s:
FEFC 1221             (    tb_dv_asm.asm):00195           fdb   $1221 ;u or s
FEFE                  (    tb_dv_asm.asm):00196         init_pc:
FEFE FA2B             (    tb_dv_asm.asm):00197           fdb   code_under_test ;pc
                      (    tb_dv_asm.asm):00198         
                      (    tb_dv_asm.asm):00199         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00200         ;                           I/O Block  (240 bytes)
                      (    tb_dv_asm.asm):00201         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00202           org $ff00
FF00                  (    tb_dv_asm.asm):00203         io_block:
                      (    tb_dv_asm.asm):00204         
                      (    tb_dv_asm.asm):00205         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00206         ;                         reset / interrupt vector 
                      (    tb_dv_asm.asm):00207         ; ////////////////////////////////////////////////////////////////////////////
                      (    tb_dv_asm.asm):00208           org  $fff0
FFF0                  (    tb_dv_asm.asm):00209         vector_table:
                      (    tb_dv_asm.asm):00210         
FFF0                  (    tb_dv_asm.asm):00211         reserved_vector:
FFF0 FA00             (    tb_dv_asm.asm):00212           fdb start_s_ptr
FFF2                  (    tb_dv_asm.asm):00213         swi3_vector:
FFF2 FA00             (    tb_dv_asm.asm):00214           fdb start_s_ptr
FFF4                  (    tb_dv_asm.asm):00215         swi2_vector:
FFF4 FA00             (    tb_dv_asm.asm):00216           fdb start_s_ptr
FFF6                  (    tb_dv_asm.asm):00217         firq_vector:
FFF6 FA00             (    tb_dv_asm.asm):00218           fdb start_s_ptr
FFF8                  (    tb_dv_asm.asm):00219         irq_vector:
FFF8 FA00             (    tb_dv_asm.asm):00220           fdb start_s_ptr
FFFA                  (    tb_dv_asm.asm):00221         swi_vector:
FFFA FA00             (    tb_dv_asm.asm):00222           fdb start_s_ptr
FFFC                  (    tb_dv_asm.asm):00223         nmi_vector:
FFFC FA00             (    tb_dv_asm.asm):00224           fdb start_s_ptr
FFFE                  (    tb_dv_asm.asm):00225         reset_vector:
FFFE FA00             (    tb_dv_asm.asm):00226           fdb start_s_ptr
                      (    tb_dv_asm.asm):00227         
